# Copy to .env and fill in. Never commit the real .env.

# LLMs (Groq) — app answers go through the Portkey gateway
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=
PORTKEY_API_KEY=

# Embeddings
GEMINI_API_KEY=

# Vector store (Qdrant Cloud)
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=

# Observability (optional)
LOGFIRE_TOKEN=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Evals only: separate Groq account for the LLM judge
JUDGE_GROQ=

# UI → API address (default is fine for local runs and the Docker image)
BACKEND_URL=http://localhost:8000
